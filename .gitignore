# ── Unity ────────────────────────────────────────────────────────────────────
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/.utmp/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Auto-generated IDE files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.opensdf
*.sdf
*.tmp
*.tmp.proj
.vs/
.idea/
.vscode/
.utilities/
.gradle/

# Unity3D generated
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app

crashlytics-build.properties
*.packed

# ── Secrets / keys ───────────────────────────────────────────────────────────
# The AES key must NEVER be committed (Kitsune threat model).
key.bin
*.key.bin
**/key.bin

# ── Large local installers (Meta Quest Developer Hub, Meta XR Simulator) ──────
/Meta/
*.msi

# graphify working directory (generated artefacts live in docs/graph/)
/graphify-out/
**/graphify-out/
**/graphify-out.meta

# ── Legacy Python reference ──────────────────────────────────────────────────
legacy/python/.venv/
legacy/python/**/__pycache__/
legacy/python/**/*.pyc
legacy/python/**/*.egg-info/

# graphify / brainstorming artefacts
/graphify-out/
/.superpowers/
